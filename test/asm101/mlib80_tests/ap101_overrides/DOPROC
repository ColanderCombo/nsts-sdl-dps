         MACRO                                                          000100AA
         DOPROC &FROM,&TO,&BY,&UNTIL,&WHILE,&P1                         000200AA
         COPY  GBLVARS                                                  000300AA
         LCLA  &I                                                       000400AA
         LCLC  &LCLWK1                                                  000500AA
           PUSHLAB                                                      000600AA
           PUSHINS (DS,0H,,,,&LIND(&LI))                                000700AA
&ST(&NI)   SETA    &II+1                                                000800AA
           PUSHLAB                                                      000900AA
           AIF   (T'&FROM EQ 'O').NOIND                                 001000AA
         AIF   ('&FROM(3)' EQ '').INCR                                  001100AA
           LA   &FROM(3),&LIND(&LI)                                     001200AA
.INCR    ANOP                                                           001300AA
&I       SETA  &I+1                                                     001400AA
         AIF   ('&SYSLIST(&I,2)' EQ '').TEST                            001500AA
           AIF ('&SYSLIST(&I,2)' EQ '0').GENSR                          001600AA
             AIF ('&SYSLIST(&I,2)'(1,1) EQ '-').NEGVAL                  001700AA
               AIF (T'&SYSLIST(&I,2) EQ 'N').POSVAL                     001800AA
                 AIF ('&SYSLIST(&I,2)'(1,1) EQ '(').GENLR               001900AA
                   LH  &SYSLIST(&I,1),&SYSLIST(&I,2)                    002000AA
                   AGO .TEST                                            002100AA
.GENLR   ANOP                                                           002150AC
         AIF   ('&SYSLIST(&I,1)' EQ '&SYSLIST(&I,2,1)').TEST            002200AC
         LR    &SYSLIST(&I,1),&SYSLIST(&I,2)                            002250AC
                 AGO .TEST                                              002300AA
.POSVAL        AIF (&SYSLIST(&I,2) GE 32768).TSTMAG                     002400AA
                 LA  &SYSLIST(&I,1),&SYSLIST(&I,2)                      002500AA
                 AGO .TEST                                              002600AA
.TSTMAG        AIF (&SYSLIST(&I,2) GE 32768).FULLIT                     002700AA
             AGO .HALFLIT                                               002800AA
.NEGVAL      ANOP                                                       002900AA
&LCLWK1        SETC '&SYSLIST(&I,2)'(2,7)                               003000AA
               AIF (&LCLWK1 GE 32768).FULLIT                            003100AA
.HALFLIT     LH  &SYSLIST(&I,1),=H'&SYSLIST(&I,2)'                      003200AA
             AGO .TEST                                                  003300AA
.FULLIT      L   &SYSLIST(&I,1),=F'&SYSLIST(&I,2)'                      003400AA
             AGO .TEST                                                  003500AA
.GENSR     SR  &SYSLIST(&I,1),&SYSLIST(&I,1)                            003600AA
.TEST    AIF   (&I LT 3).INCR                                           003700AA
           AIF   (T'&UNTIL NE 'O').ERRMG2                               003800AA
.CKWHILE     AIF   (T'&WHILE NE 'O').COMPGEN                            003900AA
&LIND(&LI) DS    0H                                                     004000AA
.POSTIND   AIF   (T'&P1 EQ 'O').GETIND                                  004100AA
             AIF   (T'&BY NE 'O').PFB                                   004200AA
               AIF   (T'&TO NE 'O').PFT                                 004300AA
                 AIF   ('&FROM(3)' NE '').BCTRZ                         004400AA
                   PUSHINS (BCT,&FROM(1),&LIND(&LI))                    004500AA
                 AGO   .ERRMG                                           004600AA
.BCTRZ           PUSHINS (BCTR,&FROM(1),&FROM(3))                       004700AA
               AGO     .ERRMG                                           004800AA
.PFT           PUSHINS (BIX,&FROM(1),&LIND(&LI))
             MEXIT                                                      005000AA
.PFB         PUSHINS (BIX,&FROM(1),&LIND(&LI))
           MEXIT                                                        005200AA
.GETIND    AIF   ('&FROM(3)' EQ '').BCTR1                               005300AA
             PUSHINS (BCTR,&FROM(1),&FROM(3))                           005400AA
           MEXIT                                                        005500AA
.BCTR1     AIF   (T'&BY NE 'O').FB                                      005600AA
             AIF   (T'&TO EQ 'O').FONLY                                 005700AA
               PUSHINS (BIX,&FROM(1),&LIND(&LI))
             MEXIT                                                      005900AA
.FONLY       PUSHINS (BCT,&FROM(1),&LIND(&LI))                          006000AA
           MEXIT                                                        006100AA
.FB        AIF   (T'&TO NE 'O').FTB                                     006200AA
             AIF   ('&BY(2)' EQ '').GENBXLE                             006300AA
             AIF   ('&BY(2)'(1,1) NE '-').GENBXLE                       006400AA
           AGO   .GENBXH                                                006500AA
.FTB       AIF   ('&TO(2)' EQ '' OR '&FROM(2)' EQ '').GENBXLE           006600AA
           AIF   ('&FROM(2)'(1,1) EQ '-').TRYTNEG                       006700AA
             AIF   (T'&FROM(2) NE 'N').GENBXLE                          006800AA
             AIF   ('&TO(2)'(1,1) EQ '-').GENBXH                        006900AA
             AIF   (T'&TO(2) NE 'N').GENBXLE                            007000AA
             AIF   (&FROM(2) GT &TO(2)).GENBXH                          007100AA
.GENBXLE   PUSHINS (BIX,&FROM(1),&LIND(&LI))
           MEXIT                                                        007300AA
.TRYTNEG   AIF   ('&TO(2)'(1,1) NE '-').GENBXLE                         007400AA
           AIF   ('&FROM(2)'(2,7) GE '&TO(2)'(2,7)).GENBXLE             007500AA
.GENBXH    PUSHINS (BIX,&FROM(1),&LIND(&LI))
           MEXIT                                                        007700AA
.NOIND       AIF   (T'&WHILE EQ 'O').NOWHILE                            007800AA
               AIF   (T'&UNTIL NE 'O').COMPGEN                          007900AA
                 BC    07,&LIND(&LI)                                    008000AA
                 PUSHLAB                                                008100AA
&LI              SETA &LI-1                                             008200AA
&LIND(&LI+1)     DS   0H                                                008300AA
                 AIF   ('&WHILE(6)' EQ '').OKSUBL                       008400AA
                   STKINS &WHILE                                        008500AA
                   MEXIT                                                008600AA
.OKSUBL          STKINS (&WHILE(1),&WHILE(2),&WHILE(3),&WHILE(4),      X008700AA
               &WHILE(5),&LIND(&LI))                                    008800AA
                 AIF   ('&WHILE(2)' EQ '').LABEL                        008900AA
                   PUSHINS (BC,&CCVAL,&LIND(&LI+1))                     009000AA
                   MEXIT                                                009100AA
.LABEL           PUSHINS   (BC,&CCVAL,&LIND(&LI+1),,,&LIND(&LI))        009200AA
                 MEXIT                                                  009300AA
.NOWHILE     AIF   (T'&UNTIL EQ 'O').TRYINF                             009400AA
&LIND(&LI)   DS    0H                                                   009500AA
.UNT           STKINS &UNTIL                                            009600AA
               PUSHINS (BC,07-&CCVAL,&LIND(&LI))                        009700AA
             MEXIT                                                      009800AA
.TRYINF        AIF   ('&P1' NE 'INF').ERRMG1                            009900AA
&LIND(&LI)       DS  0H                                                 010000AA
                 PUSHINS (BC,07,&LIND(&LI))                             010100AA
               MEXIT                                                    010200AA
.COMPGEN     AIF   ('&WHILE(6)' EQ '').OK                               010300AA
               STKINS &WHILE                                            010400AA
               AGO   .BCHINST                                           010500AA
.OK          STKINS (&WHILE(1),&WHILE(2),&WHILE(3),&WHILE(4),          X010600AA
               &WHILE(5),&LIND(&LI))                                    010700AA
             AIF   (N'&WHILE GT 1).ENDCOMP                              010800AA
&LIND(&LI)     BC    07-&CCVAL,&LIND(&LI-1)                             010900AA
               AGO   .FLAGEQU                                           011000AA
.ENDCOMP     ANOP                                                       011100AA
&ST(&NI+1)   SETA  &II                                                  011200AA
             POPINS &ST(&NI+1)                                          011300AA
.BCHINST     BC    07-&CCVAL,&LIND(&LI-1)                               011400AA
.FLAGEQU     ANOP                                                       011500AA
&NEST(&NI)   SETC  '   Y'.'&NEST(&NI)'(5,4)                             011600AA
             AIF   (T'&FROM NE 'O').POSTIND                             011700AA
           AGO   .UNT                                                   011800AA
.ERRMG   MNOTE 4,'POSITIONAL PARAMETER IGNORED. BCT/BCTR LOOP END USED' 011900AA
         MEXIT                                                          012000AA
.ERRMG2  MNOTE 4,'UNTIL KEYWORD INVALID WITH INDEXING GROUP. IGNORED'   012100AA
         AGO   .CKWHILE                                                 012200AA
.ERRMG1  MNOTE 4,'NO WHILE,UNTIL,OR INDEXING PARAMETERS ON DO MACRO.'   012300AA
         MEND                                                           012400AA
