#!/bin/bash
# con80build wrapper script - auto-generated by CMake
# Uses the Python venv at: @SDL_VENV_DIR@
#
# Build an OI flight load (e.g. OI340600/SSW) end to end: resolve+classify the
# CON80 worklist (--plan), assemble the ASM sources (--assemble), compile the
# HAL sources in template order (--hal).  Outputs land under the --out root.
#
# --python defaults to this venv's interpreter (so the asm101/lnk101 subprocesses
# resolve), and --halsc is pre-pointed at the configured halsc wrapper below so
# the --hal stage works regardless of the current directory.  Both are plain
# options, so anything the caller passes after them wins.  The HAL stage
# also needs --pass-rel32 (the PASS.REL32V0 toolchain dir); pass it when not
# running from the source tree.
exec "@SDL_VENV_PYTHON@" -m ap101Utils.con80build --halsc "@WRAPPER_BINDIR@/halsc" "$@"
