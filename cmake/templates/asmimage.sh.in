#!/bin/bash
# asmimage wrapper script - auto-generated by CMake
# Uses the Python venv at: @SDL_VENV_DIR@
#
# Assemble a standalone AP-101 program with asm101, locate it at a fixed
# address with lnk101, and write the located halfwords and symbol table as
# the JSON image the simulator embeds.

exec "@SDL_VENV_PYTHON@" -m tools.asmimage "$@"
