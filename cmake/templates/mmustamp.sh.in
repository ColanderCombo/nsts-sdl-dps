#!/bin/bash
# mmustamp wrapper script - auto-generated by CMake
# Uses the Python venv at: @SDL_VENV_DIR@
#
# Write the Mass-Memory-Build tables (#PFCMGPT, #PCDCPHA, FCMG3DAT) into the
# phase load modules that carry them, which is what mmu2mmv lays onto the
# tape.  --restore puts the linkedit content back.

exec "@SDL_VENV_PYTHON@" -m tools.mmustamp "$@"
