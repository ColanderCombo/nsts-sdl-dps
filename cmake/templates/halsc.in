#!/bin/bash
#
# halsc — HAL/S-FC Compiler Wrapper
#
# Drives the multi-pass HAL/S-FC compiler pipeline (PASS1 → FLO → OPT → AUXP → PASS2)
# producing an AP-101S object file from HAL/S source.
#
# Usage: halsc [options] source.hal
#
# Options:
#   -o FILE          Output object file (default: source.obj)
#   -v               Verbose output
#   -k, --keep       Keep intermediate files
#   --parm=OPTS      Compiler options (e.g. SRN,LISTING2,LIST,NOTABLES,DECK,HALMAT).
#                    If OPTS has no CARDTYPE=, the upstream HALSFC default is
#                    supplied (CARDTYPE=UDVMWCXCYCZM; YMZC variant for --bfs).
#   --sdf=DIR        Save the PASS3-generated SDF library members to DIR,
#                    and give PASS1 the same directory as its SDF include
#                    library (--sdfi): D INCLUDE TEMPLATE members whose SDF
#                    exists there are included from the SDF (as flight did),
#                    with textual template fallback for the rest.  PASS3
#                    (SDF generation) runs whenever NOTABLES is absent from
#                    --parm; it needs the symbol tables.
#   --sdfi=DIR       SDF include library only (input, nothing written back):
#                    like --sdf's read side without collecting this unit's
#                    SDF.  Overrides the directory implied by --sdf.
#   --bfs            Use BFS variant
#   --templib=DIR    Template library path (input; also where templates
#                    generated by the compilation are written back, unless
#                    --templib-out says otherwise)
#   --templib-out=DIR  Write templates generated by THIS compilation here
#                    instead of back into --templib.  The same read/write
#                    split --sdfi and --sdf already give the SDF library: it
#                    lets concurrent compilations share one template library
#                    without racing to write it, and leaves the caller to
#                    decide what to publish.  Created if absent; defaults to
#                    --templib.
#   --inclib=DIR     Inclusion library path (D INCLUDE macros; default build/lib/INCLIB)
#   --inclib-ebcdic=DIR  Like --inclib, but declares the library already to
#                    hold EBCDIC card images, so the ASCII-detection and
#                    conversion pass over every member is skipped.  For
#                    callers that built the library themselves (prepareINCLIB
#                    output is EBCDIC by construction) and would only pay to
#                    have it re-examined.
#   --errorlib=DIR   Error library path
#   --listing=FILE   Save listing
#   --pass1-rpt=FILE Save PASS1 report
#   --pass2-rpt=FILE Save PASS2 report
#   --halmat=FILE    Save HALMAT output
#   --litfile=FILE   Save literal table
#   --workdir=DIR    Working directory for intermediate files

# Where the compiler executables and libraries were installed at configure
# time.  Both may be overridden in the environment, so a caller can drive a
# HAL/S-FC build of its own -- a newer one, or one under test -- without
# reconfiguring or editing this wrapper.
HALSFC_BINDIR="${HALSFC_BINDIR:-@WRAPPER_BINDIR@}"
HALSFC_LIBDIR="${HALSFC_LIBDIR:-@WRAPPER_LIBDIR@}"

# Defaults
OUTPUT="" VERBOSE=0 KEEP_TEMPS=0 PARM_STRING="" TARGET="PASS"
TEMPLIB="" TEMPLIB_OUT="" INCLIB="" INCLIB_IS_EBCDIC=0 ERRORLIB="${HALSFC_LIBDIR}/ERRORLIB"
LISTING_FILE="" PASS1_RPT="" PASS2_RPT="" HALMAT_FILE="" LITFILE="" WORKDIR=""
SDF_DIR="" SDFI_DIR=""
SOURCE_FILE=""

die() { echo "halsc: $*" >&2; exit 1; }
log() { [[ $VERBOSE -eq 1 ]] && echo "$*" >&2; }

# Resolve a path to absolute relative to $ORIG_PWD
abs() { [[ "$1" == /* ]] && echo "$1" || echo "${ORIG_PWD}/$1"; }

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o)             OUTPUT="$2"; shift 2 ;;
        -v|--verbose)   VERBOSE=1; shift ;;
        -k|--keep)      KEEP_TEMPS=1; shift ;;
        --parm=*)       PARM_STRING="${1#--parm=}"; shift ;;
        --bfs)          TARGET="BFS"; shift ;;
        --templib=*)    TEMPLIB="${1#--templib=}"; shift ;;
        --templib-out=*) TEMPLIB_OUT="${1#--templib-out=}"; shift ;;
        --inclib=*)     INCLIB="${1#--inclib=}"; shift ;;
        --inclib-ebcdic=*) INCLIB="${1#--inclib-ebcdic=}"; INCLIB_IS_EBCDIC=1; shift ;;
        --errorlib=*)   ERRORLIB="${1#--errorlib=}"; shift ;;
        --listing=*)    LISTING_FILE="${1#--listing=}"; shift ;;
        --pass1-rpt=*)  PASS1_RPT="${1#--pass1-rpt=}"; shift ;;
        --pass2-rpt=*)  PASS2_RPT="${1#--pass2-rpt=}"; shift ;;
        --halmat=*)     HALMAT_FILE="${1#--halmat=}"; shift ;;
        --litfile=*)    LITFILE="${1#--litfile=}"; shift ;;
        --sdf=*)        SDF_DIR="${1#--sdf=}"; shift ;;
        --sdfi=*)       SDFI_DIR="${1#--sdfi=}"; shift ;;
        --workdir=*)    WORKDIR="${1#--workdir=}"; shift ;;
        -h|--help)      sed -n '3,/^[^#]/{ s/^# \?//p }' "$0"; exit 0 ;;
        -*)             die "unknown option: $1" ;;
        *)              [[ -n "$SOURCE_FILE" ]] && die "multiple source files not supported"
                        SOURCE_FILE="$1"; shift ;;
    esac
done

[[ -z "$SOURCE_FILE" ]] && die "no input file\nUsage: halsc [options] source.hal"
[[ -f "$SOURCE_FILE" ]] || die "$SOURCE_FILE: No such file"

SOURCE_FILE="$(realpath "$SOURCE_FILE")"
SOURCE_NAME="$(basename "${SOURCE_FILE%.*}")"
ORIG_PWD="$PWD"

# Resolve output paths
OUTPUT="$(abs "${OUTPUT:-${SOURCE_NAME}.obj}")"
[[ -n "$LISTING_FILE" ]] && LISTING_FILE="$(abs "$LISTING_FILE")"
[[ -n "$PASS1_RPT" ]]    && PASS1_RPT="$(abs "$PASS1_RPT")"
[[ -n "$PASS2_RPT" ]]    && PASS2_RPT="$(abs "$PASS2_RPT")"
[[ -n "$HALMAT_FILE" ]]  && HALMAT_FILE="$(abs "$HALMAT_FILE")"
[[ -n "$LITFILE" ]]      && LITFILE="$(abs "$LITFILE")"
[[ -n "$SDF_DIR" ]]      && SDF_DIR="$(abs "$SDF_DIR")"
[[ -n "$SDFI_DIR" ]]     && SDFI_DIR="$(abs "$SDFI_DIR")"

# Library paths are used after cd'ing into the workdir, so resolve them now
[[ -n "$TEMPLIB" ]]  && TEMPLIB="$(abs "$TEMPLIB")"
[[ -n "$TEMPLIB_OUT" ]] && TEMPLIB_OUT="$(abs "$TEMPLIB_OUT")"
[[ -n "$INCLIB" ]]   && INCLIB="$(abs "$INCLIB")"
[[ -n "$ERRORLIB" ]] && ERRORLIB="$(abs "$ERRORLIB")"

# Compiler executables
if [[ "$TARGET" == "BFS" ]]; then
    PASS1="${HALSFC_BINDIR}/HALSFC-PASS1B"
    OPT="${HALSFC_BINDIR}/HALSFC-OPTB"
    PASS2="${HALSFC_BINDIR}/HALSFC-PASS2B"
    PASS3="${HALSFC_BINDIR}/HALSFC-PASS3B"
    TEMPLIB_NAME="TEMPLIBB"
    INCLIB_NAME="INCLIBB"
    CARDS_ARG="--pdso=3,cards.bin,E"
    DEFAULT_CARDTYPE="CARDTYPE=UDVMWCXCYMZC"
else
    PASS1="${HALSFC_BINDIR}/HALSFC-PASS1"
    OPT="${HALSFC_BINDIR}/HALSFC-OPT"
    PASS2="${HALSFC_BINDIR}/HALSFC-PASS2"
    PASS3="${HALSFC_BINDIR}/HALSFC-PASS3"
    TEMPLIB_NAME="TEMPLIB"
    INCLIB_NAME="INCLIB"
    CARDS_ARG="--ddo=3,cards.bin,E"
    DEFAULT_CARDTYPE="CARDTYPE=UDVMWCXCYCZM"
fi
FLO="${HALSFC_BINDIR}/HALSFC-FLO"
AUXP="${HALSFC_BINDIR}/HALSFC-AUXP"

# Mirror the upstream HALSFC driver: if the caller's parms carry no CARDTYPE,
# supply the full default alias set (U->D, V->M, W->C, X->C, Y/Z per target)
# so sources using the virtualagc sample-file card conventions compile.
if [[ "$PARM_STRING" != *CARDTYPE=* ]]; then
    [[ -n "$PARM_STRING" ]] && PARM_STRING="${PARM_STRING},"
    PARM_STRING="${PARM_STRING}${DEFAULT_CARDTYPE}"
fi

# PASS3 (SDF generation) needs the symbol tables, so — as in the upstream
# driver — it runs exactly when NOTABLES is absent from the parms.
RUN_PASS3=0
[[ "$PARM_STRING" != *NOTABLES* ]] && RUN_PASS3=1

for exe in "$PASS1" "$FLO" "$OPT" "$AUXP" "$PASS2"; do
    [[ -x "$exe" ]] || die "compiler component not found: $exe"
done
[[ $RUN_PASS3 -eq 1 && ! -x "$PASS3" ]] && die "compiler component not found: $PASS3"

[[ -z "$TEMPLIB" ]] && TEMPLIB="${HALSFC_LIBDIR}/${TEMPLIB_NAME}"
[[ -z "$TEMPLIB_OUT" ]] && TEMPLIB_OUT="$TEMPLIB"
mkdir -p "$TEMPLIB_OUT"
[[ -z "$INCLIB" ]] && INCLIB="${HALSFC_LIBDIR}/${INCLIB_NAME}"
mkdir -p "$INCLIB"

# Working directory
if [[ -z "$WORKDIR" ]]; then
    WORKDIR="$(mktemp -d)"; CLEANUP=1
else
    WORKDIR="$(abs "$WORKDIR")"
    mkdir -p "$WORKDIR"; CLEANUP=0
fi

# JCL's &&TEMPINC is a job-temporary dataset: D DEFINE'd macro members must
# not survive into another compile (or a re-compile), else PASS1 raises XD9
# "ALREADY EXISTS" and PASS2 abandons the unit with B100.
TEMPINC="${WORKDIR}/&&TEMPINC"
rm -rf "$TEMPINC"
mkdir -p "$TEMPINC"
trap '[[ $CLEANUP -eq 1 && $KEEP_TEMPS -eq 0 ]] && rm -rf "$WORKDIR"; [[ $KEEP_TEMPS -eq 1 ]] && echo "halsc: intermediates in $WORKDIR" >&2' EXIT

# The compiler reads the include library (file 8) with the E flag, i.e. as
# 80-byte EBCDIC card images.  If the library holds ASCII text members
# (e.g. the OI SDL INCL80 tree), convert them into an EBCDIC copy in the
# workdir and point the compiler there.  Members that are already card
# images (length a multiple of 80, no newlines) are copied through as-is.
if [[ $INCLIB_IS_EBCDIC -eq 0 ]] && [[ -d "$INCLIB" ]] && [[ -n "$(ls -A "$INCLIB" 2>/dev/null)" ]]; then
    CONVERTED_INCLIB="${WORKDIR}/INCLIB.ebcdic"
    mkdir -p "$CONVERTED_INCLIB"
    n_converted=$(python3 - "$INCLIB" "$CONVERTED_INCLIB" <<'PYEOF'
import codecs, pathlib, shutil, sys
src, dst = map(pathlib.Path, sys.argv[1:3])
converted = 0
for m in sorted(src.iterdir()):
    if not m.is_file():
        continue
    data = m.read_bytes()
    out = dst / m.name
    if data and len(data) % 80 == 0 and b'\n' not in data:
        shutil.copyfile(m, out)         # already EBCDIC card images
    else:
        buf = bytearray()
        for line in data.decode('ascii', 'replace').splitlines():
            buf += codecs.encode((line + ' ' * 80)[:80], 'cp037')
        out.write_bytes(bytes(buf))
        converted += 1
print(converted)
PYEOF
) || die "include library conversion failed for $INCLIB"
    [[ "$n_converted" -gt 0 ]] && log "Converted $n_converted ASCII INCLIB member(s) to EBCDIC"
    INCLIB="$CONVERTED_INCLIB"
fi

cd "$WORKDIR"

# Did a compiler pass fail?  Mirrors HALSFC's passFailed().
#
# The passes follow the OS/360 convention the HAL/S-FC XPL is written to: the
# outermost scope's RETURN value is SHL(MAX_SEVERITY,2) -- 0 clean, 4 warnings,
# 8 errors, and up.  The compiler's own viability rule is MAX_SEVERITY < 2, so
# below 8 is tolerable.  Treating 4 as fatal would discard a perfectly good
# object module and skip PASS3, leaving no SDF for anything downstream to
# include; OPT's ZO3 warning (SEVERITY_ONE -> PASS2 returns 4) is the common
# case.  Everything that is not a severity is >= 8 by construction: XCOM-I's
# runtime abends with 255, XPL's CALL EXIT gives 10, HALSFC reserves 240-254,
# and a shell reports a fatal signal as 128+N.
PASS_SEVERITY_FATAL=8

# Run a compiler pass, capturing output to <name>.rpt
run() {
    local name="$1"; shift
    local rpt="$(echo "$name" | tr '[:upper:]' '[:lower:]').rpt"
    local rc
    log "[$name] Running..."
    "$@" > "$rpt" 2>&1
    rc=$?
    if (( rc >= PASS_SEVERITY_FATAL )); then
        echo "halsc: $name failed compiling $SOURCE_NAME (rc=$rc)" >&2
        cat "$rpt" >&2
        exit 1
    fi
    (( rc != 0 )) && log "[$name] rc=$rc (severity $(( rc / 4 )), tolerated)"
    return 0
}

log "Compiling $SOURCE_FILE..."

# The SDF include library: members present there are included as SDF
# binaries (the flight-faithful path, INCSDF.xpl); missing members fall
# back to textual templates.  --sdfi selects it explicitly (input-only);
# with --sdf alone the shared collection directory doubles as the library.
[[ -z "$SDFI_DIR" ]] && SDFI_DIR="$SDF_DIR"
SDFI_ARG=()
[[ -n "$SDFI_DIR" && -d "$SDFI_DIR" ]] && SDFI_ARG=("--sdfi=$SDFI_DIR")
run PASS1 "$PASS1" "${SDFI_ARG[@]}" \
    --parm="$PARM_STRING" \
    --ddi=0,"$SOURCE_FILE" \
    --ddo=2,listing2.txt \
    --pdsi=4,"$TEMPLIB",E --pdsi=5,"$ERRORLIB" \
    --pdsi=6,ACCESS --pdso=6,"$TEMPLIB_OUT",E \
    --pdsi=8,"$INCLIB",E --pdso=8,"$TEMPINC",E \
    --pdsi=9,"$TEMPINC",E \
    --commono=COMMON0.out \
    --raf=O,7200,1,halmat.bin --raf=B,1560,2,litfile.bin \
    --raf=B,1600,3,icfile.bin --raf=B,3360,6,vmem.bin

run FLO "$FLO" \
    --commoni=COMMON0.out --commono=COMMON1.out --pdsi=5,"$ERRORLIB" \
    --raf=I,7200,1,halmat.bin --raf=I,1560,2,litfile.bin --raf=B,3360,6,vmem.bin

run OPT "$OPT" \
    --commoni=COMMON1.out --commono=COMMON2.out --pdsi=5,"$ERRORLIB" \
    --raf=I,7200,1,halmat.bin --raf=B,1560,2,litfile.bin \
    --raf=O,7200,4,optmat.bin --raf=B,3360,6,vmem.bin

run AUXP "$AUXP" \
    --commoni=COMMON2.out --commono=COMMON3.out --pdsi=5,"$ERRORLIB" \
    --raf=O,7200,1,auxmat.bin --raf=I,1560,2,litfile.bin \
    --raf=I,7200,4,optmat.bin --raf=B,3360,6,vmem.bin

run PASS2 "$PASS2" \
    "$CARDS_ARG" --ddo=4,deck.bin,E --pdsi=5,"$ERRORLIB" --ddo=7,extra.txt \
    --commoni=COMMON3.out --commono=COMMON4.out \
    --raf=I,7200,1,auxmat.bin --raf=B,1560,2,litfile.bin \
    --raf=B,1600,3,objcode.bin --raf=I,7200,4,optmat.bin --raf=B,3360,6,vmem.bin

# PASS3: SDF (Simulation Data File) generation.  Writes one <unit>.sdf
# member into ./SDFLIB (the XCOM-I runtime's default --sdfo directory).
# PASS3 exits nonzero merely for advisory messages (YA100 etc.), which the
# severity rule above already tolerates.  We diverge from HALSFC in one way:
# it aborts when PASS3 fails outright, whereas an SDF failure must not kill an
# otherwise-complete compile here (the object already exists, and con80 needs
# it) -- so report and continue.  A missing SDFLIB member is caught below.
if [[ $RUN_PASS3 -eq 1 ]]; then
    "$PASS3" \
        --pdsi=5,"$ERRORLIB" \
        --commoni=COMMON4.out --commono=COMMON5.out \
        --raf=B,1560,2,litfile.bin --raf=B,3360,6,vmem.bin \
        > pass3.rpt 2>&1
    PASS3_RC=$?
    if (( PASS3_RC >= PASS_SEVERITY_FATAL )); then
        echo "halsc: warning: PASS3 (SDF generation) rc=$PASS3_RC for $SOURCE_NAME" >&2
    fi
fi

# Copy outputs
cp cards.bin "$OUTPUT"
if [[ -n "$SDF_DIR" ]]; then
    if [[ -d SDFLIB ]]; then
        mkdir -p "$SDF_DIR"
        cp SDFLIB/* "$SDF_DIR"/
        log "SDF members saved to $SDF_DIR"
    else
        echo "halsc: warning: --sdf given but no SDFLIB was produced" >&2
    fi
fi
[[ -n "$LISTING_FILE" && -f listing2.txt ]] && cp listing2.txt "$LISTING_FILE"
[[ -n "$PASS1_RPT"    && -f pass1.rpt    ]] && cp pass1.rpt "$PASS1_RPT"
[[ -n "$PASS2_RPT"    && -f pass2.rpt    ]] && cp pass2.rpt "$PASS2_RPT"
[[ -n "$HALMAT_FILE"  && -f halmat.bin   ]] && cp halmat.bin "$HALMAT_FILE"
[[ -n "$LITFILE"      && -f litfile.bin  ]] && cp litfile.bin "$LITFILE"

log "Output: $OUTPUT"
echo "halsc: $SOURCE_NAME compiled successfully"
