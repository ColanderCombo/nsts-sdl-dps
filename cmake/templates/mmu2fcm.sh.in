#!/bin/bash
# mmu2fcm wrapper script - auto-generated by CMake
# Uses the Python venv at: @SDL_VENV_DIR@
#
# Compose linked phase load modules (.lib) into a memory-configuration .fcm
# image by emulating the GPC IPL/SSL load (IPL background fill + load blocks
# in IPL phase order).  Default composes SSW (= IPL PH=(10,2,13,3)) from
# build/mmu into build/mmu/SSW; score it with tools/fidelity/cmp_bytes.py.

exec "@SDL_VENV_PYTHON@" -m ap101Utils.mmu2fcm "$@"
